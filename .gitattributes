* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.glb binary
*.gltf binary
*.zip binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary

# Preserve the upstream font license files byte-for-byte.
blue-ocean-game/public/assets/fonts/**/OFL.txt whitespace=-blank-at-eol

# Windows launchers keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Production output is built by CI; local output is excluded by .gitignore.
